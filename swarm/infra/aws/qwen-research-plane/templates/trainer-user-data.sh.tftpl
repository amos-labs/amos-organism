#!/usr/bin/env bash
set -euo pipefail

exec > >(tee -a /var/log/amos-qwen-trainer-bootstrap.log | logger -t amos-qwen-trainer -s 2>/dev/console) 2>&1

for binary in aws docker nvidia-smi; do
  command -v "$binary" >/dev/null || {
    echo "Required trainer binary is unavailable: $binary"
    exit 1
  }
done

nvidia-smi
install -d -m 0750 -o 10001 -g 10001 \
  /opt/amos-stage0 \
  /opt/amos-huggingface \
  /opt/amos-triton \
  /opt/amos-nvidia-cache
# The contract to train comes from an SSM parameter the consolidation runner
# rewrites before each start, so a stopped trainer can be re-aimed without a
# Terraform apply. The baked value is the fallback when the parameter is unset.
CONTRACT_URI="$(aws ssm get-parameter \
  --region "${aws_region}" \
  --name "${trainer_contract_parameter}" \
  --query Parameter.Value \
  --output text 2>/dev/null || true)"
if [[ -z "$CONTRACT_URI" || "$CONTRACT_URI" == "None" || "$CONTRACT_URI" == "unset" ]]; then
  CONTRACT_URI="${trainer_contract_uri}"
fi
echo "AMOS Qwen trainer contract: $CONTRACT_URI"
aws ecr get-login-password --region "${aws_region}" | \
  docker login --username AWS --password-stdin "${ecr_registry}"
docker pull "${trainer_image_uri}"

set +e
docker run \
  --name amos-qwen-stage0-trainer \
  --gpus all \
  --ipc=host \
  --network=bridge \
  --read-only \
  --tmpfs /tmp:rw,noexec,nosuid,size=16g \
  --env "AMOS_TRAINING_CONTRACT_URI=$CONTRACT_URI" \
  --env TORCH_DISABLE_NATIVE_JIT=1 \
  --env HF_HOME=/home/trainer/.cache/huggingface \
  --env TRITON_CACHE_DIR=/home/trainer/.triton/cache \
  --env CUDA_CACHE_PATH=/home/trainer/.nv/ComputeCache \
  --volume /opt/amos-stage0:/work/stage0:rw \
  --volume /opt/amos-huggingface:/home/trainer/.cache/huggingface:rw \
  --volume /opt/amos-triton:/home/trainer/.triton:rw \
  --volume /opt/amos-nvidia-cache:/home/trainer/.nv:rw \
  "${trainer_image_uri}"
STATUS=$?
set -e

printf '%s\n' "$STATUS" > /opt/amos-stage0/container-exit-status
sync
if [[ "$STATUS" -eq 0 ]]; then
  echo "AMOS Qwen trainer completed; stopping the disposable instance"
else
  echo "AMOS Qwen trainer failed with status $STATUS; preserving disk and stopping for inspection"
fi
shutdown -h now
