{
  "name": "@amos-labs/organism",
  "version": "0.1.0",
  "private": true,
  "description": "Governed self-improving intelligence runtime with causal credit and procedural lineage, plus the Qwen swarm self-learning experiment that feeds it",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "preinstall": "node scripts/requireNode.mjs",
    "test": "node --test test/*.test.ts swarm/test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage test/*.test.ts swarm/test/*.test.js",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run check:swarm && npm test",
    "test:kernel": "node --test test/*.test.ts",
    "test:swarm": "node --test swarm/test/*.test.js",
    "check:swarm": "node swarm/scripts/checkSwarmSyntax.mjs",
    "test:python": "python3 -m pytest -q swarm/benchmarks/harbor_agents swarm/infra/aws/qwen-research-plane",
    "research:qwen-baseline": "node swarm/scripts/runQwenResearchBaseline.js",
    "research:validate-quality-portfolio": "node swarm/scripts/validateFrontierQualityPortfolio.js",
    "research:swarm": "node swarm/scripts/runSwarmExperiment.js",
    "research:swarm:collect-owned": "node swarm/scripts/collectAmosOwnedSwarmEpisodes.js",
    "research:swarm:collect": "node swarm/scripts/collectHarborSwarmEpisodes.js",
    "research:swarm:collect-platform": "node swarm/scripts/collectPlatformMissionEpisode.js",
    "research:swarm:export-adapter-data": "node swarm/scripts/exportAmosNativeTrainingDataset.js",
    "research:swarm:generate-stage0-data": "node swarm/scripts/generateAmosSyntheticCurriculum.js",
    "research:swarm:generate-stage1-data": "node swarm/scripts/generateAmosCurriculum.js",
    "research:swarm:extract-tool-catalog": "node swarm/scripts/extractAmosToolCatalog.mjs",
    "research:swarm:prepare-stage0-trainer": "node swarm/scripts/prepareQwenAdapterStage0.js",
    "research:swarm:simulate": "node swarm/scripts/simulateSwarmOrganismTraining.js",
    "research:swarm:prepare-process": "node swarm/scripts/prepareProcessMiningOrganismCurriculum.js",
    "research:swarm:queue-candidates": "node swarm/scripts/createSwarmOrganismPromotionQueue.js",
    "research:swarm:evaluate-candidates": "node swarm/scripts/evaluateSwarmOrganismCandidates.js",
    "research:swarm:replay-artifacts": "node swarm/scripts/replaySwarmOrganismArtifacts.js",
    "research:swarm:sleep": "node swarm/scripts/runSleepCycle.js",
    "research:swarm:grade-curriculum": "node swarm/scripts/gradeCurriculum.js",
    "research:swarm:consolidate-adapter": "node swarm/scripts/runAdapterConsolidation.js",
    "research:swarm:export-trace-bundle": "node swarm/scripts/exportOrganismTraceBundle.js",
    "research:swarm:import-trace-bundle": "node scripts/importTraceBundle.ts",
    "organism:serve-platform-intake": "node scripts/servePlatformEpisodeIntake.ts",
    "research:swarm:qualify-evolution": "python3 swarm/scripts/qualifySwarmCandidateEvolution.py",
    "research:swarm:hrr-v2": "node swarm/scripts/benchmarkHolographicWorldV2.js",
    "research:swarm:hrr-dual": "node swarm/scripts/benchmarkDualChannelHolographicWorld.js",
    "research:swarm:rank-bids": "node swarm/scripts/rankHolographicSwarmBids.js",
    "research:swarm:validate-policy": "node swarm/scripts/validateHolographicSwarmPolicy.js",
    "research:swarm:select-recursive-policy": "node swarm/scripts/selectRecursiveOrganismPolicy.js",
    "research:swarm:summarize-cycle": "node swarm/scripts/summarizeRecursiveOrganismCycle.js",
    "research:swarm:phase-probes": "node swarm/scripts/runSwarmOrganismQwenPhaseProbes.js",
    "research:swarm:blind": "node swarm/scripts/prepareSwarmBlindComparison.js",
    "research:swarm:gateway": "node swarm/scripts/runSwarmTurnGateway.js",
    "research:memory-benchmark": "node swarm/scripts/runBusinessMemoryBenchmark.js",
    "research:memory-harvest": "node swarm/scripts/harvestBusinessMemoryProcedures.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
